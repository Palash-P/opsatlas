# Local development environment. Production deployments must inject real
# secrets and set APP_ENV=production; startup fails closed if the development
# password, empty AUTH_TOKENS, or the default log salt are still present.
APP_ENV=local
APP_NAME=OpsAtlas

# PostgreSQL host port published by Docker Compose. The container always
# listens on 5432 and other containers connect to postgres:5432; this variable
# only changes the port on your machine. 5433 avoids a conflict with a locally
# installed PostgreSQL server that may already own 5432.
POSTGRES_PORT=5433
# Bind published datastore ports to loopback by default. Change these only for
# a controlled remote-development setup; production must not publish them.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=opsatlas
# Development-only placeholder. Replace before any shared or production use.
POSTGRES_PASSWORD=opsatlas_dev_password
POSTGRES_DB=opsatlas

# Used by host-run processes (API, workers started from the host, migrations,
# tests). Keep the port here in sync with POSTGRES_PORT. Inside Compose the same
# services get their DATABASE_URL from docker-compose.yml using postgres:5432.
DATABASE_URL=postgresql+psycopg://opsatlas:opsatlas_dev_password@localhost:5433/opsatlas
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# Redis host port and bind address. Redis has no authentication in this local
# Compose file, so loopback is the safe default.
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1

# Host port/address for the Docker Compose API service. The container always
# listens on 8000. Keep the default loopback bind and terminate TLS in a reverse
# proxy for any non-local deployment.
API_PORT=8000
API_BIND_ADDRESS=127.0.0.1

# Background ingestion queue. Celery uses Redis as a broker only; durable job
# state is in PostgreSQL, so there is intentionally no result backend. Keep the
# broker on a different Redis database from REDIS_URL.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=ingestion
# Periodic reconciliation runs on a separate queue consumed by the dedicated
# reconciliation worker, so a busy ingestion backlog cannot starve recovery.
# This must differ from CELERY_TASK_DEFAULT_QUEUE.
CELERY_RECONCILIATION_QUEUE=reconciliation
CELERY_RECONCILIATION_WORKER_CONCURRENCY=1
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1800
CELERY_TASK_TIME_LIMIT_SECONDS=1860
CELERY_VISIBILITY_TIMEOUT_SECONDS=2400
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true

# Bounded retries. Only transient dependency failures and a small unexpected
# exception budget are retried; deployment/validation failures are permanent.
INGESTION_TASK_MAX_RETRIES=3
INGESTION_TASK_RETRY_BACKOFF_SECONDS=5
INGESTION_TASK_RETRY_BACKOFF_MAX_SECONDS=120
INGESTION_TASK_UNEXPECTED_MAX_RETRIES=1

# Orphan recovery. A worker renews its execution lease between embedding
# batches; an expired lease lets the reconciler dispatch a new execution and
# fences the old one out. The reconciler runs from Celery beat and can also be
# invoked manually with scripts/reconcile_ingestion_jobs.py. Dispatch backoff is
# capped independently of the job's retry budget.
INGESTION_EXECUTION_LEASE_SECONDS=300
INGESTION_RECONCILE_ENABLED=true
INGESTION_RECONCILE_INTERVAL_SECONDS=60
INGESTION_RECONCILE_BATCH_SIZE=50
INGESTION_RECONCILE_DISPATCH_LEASE_SECONDS=300
INGESTION_RECONCILE_DISPATCH_BACKOFF_SECONDS=15
INGESTION_RECONCILE_DISPATCH_BACKOFF_MAX_SECONDS=300
INGESTION_RECONCILE_TRANSIENT_GRACE_SECONDS=300

# Authentication. Protected endpoints require "Authorization: Bearer <token>".
# Each configured token maps to one authoritative tenant and principal.
# An empty map rejects every protected request with 401. Replace these example
# values and keep real tokens out of source control. Roles/groups are asserted
# by this local configuration, not synchronized from an identity provider.
# Document writes require the explicit "document_writer" role for creating a
# document or updating a document with no ACL rows. A document with any ACL row
# instead requires a matching "manage" grant. Tenant membership alone is not
# enough to write. Read-only tokens omit "document_writer".
# Optional "expires_at" is an ISO-8601 timestamp; an expired token stops
# authenticating at request time without a restart. Rotate by adding the new
# token alongside the old one, restart/redeploy both, then remove the old entry
# and restart again. Revoke by removing the entry and restarting. Production
# rejects empty maps, tokens shorter than 32 characters, and documented
# placeholders; malformed entries fail startup in every environment.
# AUTH_TOKENS={"replace-with-a-long-random-token":{"tenant_id":"00000000-0000-4000-8000-000000000001","subject":"local-dev","roles":["member","document_writer"],"groups":[],"expires_at":"2030-01-01T00:00:00Z"}}
# AUTH_LOG_TENANT_SALT=replace-with-a-random-salt

# Request protection. RATE_LIMIT_BACKEND=redis shares one sliding-window limit
# per tenant across API replicas; memory keeps the limit per process and is the
# application default for tests. Compose defaults to redis. If Redis becomes
# unreachable, the default fallback keeps enforcing the limit in each process
# and logs one sanitized warning; set RATE_LIMIT_REDIS_FALLBACK_TO_LOCAL=false
# to fail closed with 503 instead. Redis limiter keys are salted hashes of the
# tenant UUID, never tokens or raw tenant IDs.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_KEY_PREFIX=opsatlas:ratelimit
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25
RATE_LIMIT_REDIS_FALLBACK_TO_LOCAL=true
# The concurrency slot remains per process: it bounds provider/DB fan-out
# inside one API process.
MAX_CONCURRENT_REQUESTS=16
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=0.25

# Database pool and statement bounds.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
# Successful readiness schema validation is cached for this many seconds.
# Failures are always retried on the next /ready probe.
SCHEMA_VALIDATION_CACHE_SECONDS=30

# Embedding service client. The service is reached from two network namespaces,
# so there are two variables:
#
#   EMBEDDING_URL            host-run processes (API or worker started from the
#                            host, migrations, scripts, tests). Loopback is the
#                            host itself.
#   CONTAINER_EMBEDDING_URL  address injected into Compose containers. A
#                            container's loopback is the container, so it must
#                            reach the host through host.docker.internal.
#
# docker-compose.yml maps CONTAINER_EMBEDDING_URL into the container's
# EMBEDDING_URL. The host value is never passed into a container, so a plain
# "copy .env.example to .env" workflow works for both modes.
# EMBEDDING_DIMENSIONS is validated against the PostgreSQL vector column
# contract (384); changing it requires a schema migration and a re-embedding
# plan.
EMBEDDING_URL=http://127.0.0.1:8091
CONTAINER_EMBEDDING_URL=http://host.docker.internal:8091
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=1
EMBEDDING_RETRY_BACKOFF_SECONDS=0.2

# Answer generation
# The default provider is a deterministic local extractive fallback, so the
# complete answer path runs without a paid API key. It is not a production LLM.
LLM_PROVIDER=extractive
LLM_MODEL=extractive-local-v1
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25

# Opt-in OpenAI-compatible provider. Keep the key out of source control.
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://api.example.com/v1
# LLM_API_KEY=
# LLM_API_PATH=/chat/completions

# Evidence assembly. Token counts are documented character approximations.
ANSWER_CONTEXT_TOKEN_BUDGET=4000
ANSWER_MAX_EVIDENCE=8
ANSWER_CITATION_EXCERPT_CHARS=600
