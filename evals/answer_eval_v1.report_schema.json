{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsatlas.local/evals/answer_eval_v1.report_schema.json",
  "title": "OpsAtlas grounded-answer evaluation report",
  "description": "Report format for answer_eval_v1. A report with status 'not_run' is a design template, not a measured result. Scores are nullable because an evaluator may be unable to score a record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "dataset_id",
    "status",
    "run",
    "metric_definitions",
    "records",
    "aggregate",
    "limitations"
  ],
  "properties": {
    "report_version": {"type": "integer", "const": 1},
    "dataset_id": {"type": "string", "const": "answer_eval_v1"},
    "status": {
      "type": "string",
      "enum": ["not_run", "completed", "partial"],
      "description": "'not_run' means this is an unfilled design template."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_name",
        "system_version",
        "retrieval_config",
        "generation_config",
        "prompt_version",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "system_name": {"type": "string"},
        "system_version": {"type": "string"},
        "retrieval_config": {"type": "object"},
        "generation_config": {
          "type": "object",
          "additionalProperties": true,
          "required": ["provider", "model", "temperature", "max_output_tokens"],
          "properties": {
            "provider": {"type": "string"},
            "model": {"type": "string"},
            "temperature": {"type": "number"},
            "max_output_tokens": {"type": "integer"}
          }
        },
        "prompt_version": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_relevance",
        "faithfulness",
        "citation_correctness",
        "citation_completeness",
        "abstention_correctness",
        "conflict_handling"
      ],
      "properties": {
        "answer_relevance": {"type": "string"},
        "faithfulness": {"type": "string"},
        "citation_correctness": {"type": "string"},
        "citation_completeness": {"type": "string"},
        "abstention_correctness": {"type": "string"},
        "conflict_handling": {"type": "string"}
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Ordered failure labels used by failure_analysis.json. Added compatibly; older reports may omit it."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "category",
          "question",
          "answerable",
          "prediction",
          "scores",
          "scoring_notes"
        ],
        "properties": {
          "record_id": {"type": "string"},
          "category": {"type": "string"},
          "question": {"type": "string"},
          "answerable": {"type": "boolean"},
          "prediction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer",
              "abstained",
              "abstention_reason",
              "citations",
              "conflicts"
            ],
            "properties": {
              "answer": {"type": "string"},
              "abstained": {"type": "boolean"},
              "abstention_reason": {"type": ["string", "null"]},
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_key",
                    "version_number",
                    "chunk_id",
                    "excerpt"
                  ],
                  "properties": {
                    "source_key": {"type": "string"},
                    "version_number": {"type": "integer", "minimum": 1},
                    "chunk_id": {"type": "string"},
                    "excerpt": {"type": "string"}
                  }
                }
              },
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_ids", "description"],
                  "properties": {
                    "evidence_ids": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "description": {"type": "string"}
                  }
                }
              },
              "version_analysis": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/version_analysis"}
                ],
                "description": "Optional evidence-bound version analysis. Added compatibly."
              },
              "uncertainty": {
                "type": ["string", "null"],
                "description": "Optional model-stated uncertainty. Added compatibly."
              }
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer_relevance",
              "faithfulness",
              "citation_correctness",
              "citation_completeness",
              "abstention_correctness",
              "conflict_handling"
            ],
            "properties": {
              "answer_relevance": {"$ref": "#/$defs/score"},
              "faithfulness": {"$ref": "#/$defs/score"},
              "citation_correctness": {"$ref": "#/$defs/score"},
              "citation_completeness": {"$ref": "#/$defs/score"},
              "abstention_correctness": {"$ref": "#/$defs/score"},
              "conflict_handling": {"$ref": "#/$defs/score"}
            }
          },
          "scoring_notes": {"type": "string"}
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sample_counts",
        "overall",
        "by_category",
        "caveats"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["not_run", "completed", "partial"]},
        "sample_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "scored", "abstained", "answerable", "unanswerable"],
          "properties": {
            "records": {"type": "integer", "minimum": 0},
            "scored": {"type": "integer", "minimum": 0},
            "abstained": {"type": "integer", "minimum": 0},
            "answerable": {"type": "integer", "minimum": 0},
            "unanswerable": {"type": "integer", "minimum": 0},
            "provider_failures": {"type": "integer", "minimum": 0},
            "generation_contract_failures": {"type": "integer", "minimum": 0}
          }
        },
        "provider_failure_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Provider transport/envelope failures divided by records. Invalid model output is counted separately as a generation-contract failure. Added compatibly."
        },
        "overall": {"$ref": "#/$defs/metric_block"},
        "by_category": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/metric_block"}
        },
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Nullable rubric score. Null means not scored, not zero."
    },
    "version_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions_identified",
        "differences",
        "conflicting_instructions",
        "recommendation_applies_to",
        "supporting_evidence_ids"
      ],
      "properties": {
        "versions_identified": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/version_reference"}
        },
        "differences": {
          "type": "array",
          "items": {"type": "string"}
        },
        "conflicting_instructions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "recommendation_applies_to": {"type": ["string", "null"]},
        "supporting_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "version_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "version_number", "status", "evidence_ids"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "version_number": {"type": "integer", "minimum": 1},
        "status": {
          "type": "string",
          "enum": ["current", "historical", "conflicting", "unknown"]
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "metric_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_relevance",
        "faithfulness",
        "citation_correctness",
        "citation_completeness",
        "abstention_correctness",
        "conflict_handling",
        "n"
      ],
      "properties": {
        "answer_relevance": {"$ref": "#/$defs/score"},
        "faithfulness": {"$ref": "#/$defs/score"},
        "citation_correctness": {"$ref": "#/$defs/score"},
        "citation_completeness": {"$ref": "#/$defs/score"},
        "abstention_correctness": {"$ref": "#/$defs/score"},
        "conflict_handling": {"$ref": "#/$defs/score"},
        "n": {"type": "integer", "minimum": 0}
      }
    }
  }
}
