# Local environment files. Only the example belongs in version control.
.env
.env.*
!.env.example
.venv/
.venv-verify/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store

# Additional virtual environments
.venv-embed-test/

# Local database backups (never commit dumps or manifests)
backups/

# Generated package metadata
*.egg-info/

# Build artifacts
build/
dist/

# Generated evaluation reports
evals/reports/

# Generated evaluation run payloads
evals/runs/**/predictions.jsonl
evals/runs/**/scorer_raw/

# Raw operational logs and per-request load-test records
evals/ops/phase-e-final/*.log
evals/ops/phase-e-final/*.records.jsonl

# Generated evaluation run logs
evals/runs/**/*.log
